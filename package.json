{
  "name": "api-integration-in-practice",
  "version": "0.1.0",
  "private": true,
  "description": "Practical API integration patterns in TypeScript: one small runnable example per topic.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "part1": "tsx 01-why-integrations-break/demo.ts",
    "part1:server": "tsx 01-why-integrations-break/start-server.ts",
    "part2": "tsx 02-rest-soap-graphql/demo.ts",
    "part3": "tsx 03-authentication/demo.ts",
    "part4": "tsx 04-canonical-model/demo.ts",
    "part5": "tsx 05-retries-backoff/demo.ts",
    "part6": "tsx 06-rate-limiting/demo.ts",
    "part7": "tsx 07-idempotency/demo.ts",
    "part8": "tsx 08-webhooks/demo.ts",
    "part9": "tsx 09-observability/demo.ts",
    "part10": "tsx 10-nestjs/demo.ts",
    "part10:server": "tsx 10-nestjs/server.ts",
    "test": "node --import tsx --test \"**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
